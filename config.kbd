;; ==========================================================================
;; KMonad Configuration: Colemak-DH
;; - CapsLock and Backspace swapped
;; - Space-as-Ctrl (tap: space, hold: control)
;; - Right Alt -> Control
;; - Left Alt  -> Nav Layer Toggle:
;;     Row 2 (l / u / y): PageUp / Up / PageDown
;;     Row 3 (m / n / e / i / o): WordLeft / Left / Down / Right / WordRight
;;     Row 4 (h / , / .): Home / Insert / End
;;     Space (in Nav): F22 (toggles KMonad off)
;; ==========================================================================

(defcfg
  ;; Windows uses low-level keyboard hooks to capture keystrokes
  input  (low-level-hook)

  ;; Output keyboard events back into Windows
  output (send-event-sink)

  ;; Unmapped keys pass through unchanged
  fallthrough true

  ;; Disallow execution of arbitrary shell commands
  allow-cmd false
)

;; --------------------------------------------------------------------------
;; Physical Input Layout (QWERTY ANSI)
;; --------------------------------------------------------------------------
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    scln '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet cmp  rctl
)

;; --------------------------------------------------------------------------
;; Aliases
;; --------------------------------------------------------------------------
(defalias
  ;; Space: Tap for Space, Hold for Left Control (200ms threshold)
  spc-ctl (tap-hold-next-release 200 spc lctl)

  ;; Left Alt: Hold to activate Navigation layer
  nav     (layer-toggle nav)
)

;; --------------------------------------------------------------------------
;; Base Layer: Colemak-DH ANSI
;; - Row 1: bspc physical -> caps
;; - Row 3: caps physical -> bspc
;; - Bottom: Left Alt -> @nav, Space -> @spc-ctl, Right Alt -> rctl
;; --------------------------------------------------------------------------
(deflayer colemak-dh
  grv  1    2    3    4    5    6    7    8    9    0    -    =    caps
  tab  q    w    f    p    b    j    l    u    y    scln [    ]    \
  bspc a    r    s    t    g    m    n    e    i    o    '    ret
  lsft x    c    d    v    z    k    h    ,    .    /    rsft
  lctl lmet @nav          @spc-ctl        rctl rmet cmp  rctl
)

;; --------------------------------------------------------------------------
;; Navigation Layer: Activated while holding Left Alt
;;
;; Physical positions & Colemak-DH labels:
;;
;; Upper Row (physical u / i / o  -> Colemak l / u / y):
;;   U (Colemak l)  ->  PageUp
;;   I (Colemak u)  ->  Up Arrow
;;   O (Colemak y)  ->  PageDown
;;
;; Home Row (physical h / j / k / l / scln -> Colemak m / n / e / i / o):
;;   H (Colemak m)  ->  Control + Left (Word Left)
;;   J (Colemak n)  ->  Left Arrow
;;   K (Colemak e)  ->  Down Arrow
;;   L (Colemak i)  ->  Right Arrow
;;   ; (Colemak o)  ->  Control + Right (Word Right)
;;
;; Bottom Row (physical m / , / . -> Colemak h / , / .):
;;   M (Colemak h)  ->  Home
;;   , (comma)      ->  Insert
;;   . (period)     ->  End
;;
;; Bottom Modifier Row:
;;   Space          ->  F22 (KMonad toggle trigger)
;;
;; Extras:
;;   Caps (physical)->  Backspace
;;   Bspc (physical)->  Delete
;;   _              ->  Transparent (passes through)
;; --------------------------------------------------------------------------
(deflayer nav
  _    _    _    _    _    _    _      _    _    _    _       _    _    del
  _    _    _    _    _    _    _      pgup up   pgdn _       _    _    _
  bspc _    _    _    _    _    C-left left down rght C-rght  _    ret
  _    _    _    _    _    _    _      home ins  end  _       _
  _    _    _              f22               _    _    _       _
)
